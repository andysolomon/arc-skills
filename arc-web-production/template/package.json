{
  "name": "foldkit-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "vite",
    "mock": "node scripts/mock-api.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p cloudflare",
    "test": "node test/app.test.ts && node test/commands.test.ts",
    "lint:styles": "node scripts/check-styles.mjs",
    "check": "npm run typecheck && npm test && npm run lint:styles",
    "api:check": "node scripts/api-check.ts",
    "static": "node scripts/render-static.ts",
    "cf:dev": "npm run build && cd cloudflare && alchemy dev alchemy.run.ts",
    "cf:deploy": "npm run build && cd cloudflare && alchemy deploy alchemy.run.ts",
    "cf:destroy": "cd cloudflare && alchemy destroy alchemy.run.ts"
  },
  "dependencies": {
    "effect": "~4.1.4",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@foldkit/vite-plugin": "0.29.1",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.87",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
